# Copia este archivo a ".env" (en la raíz del proyecto, junto a docker-compose.yml)
# y rellena los valores reales. NUNCA subas el ".env" real a git (ya está en .gitignore).
#
# ⚠️ La versión anterior de este archivo tenía una GROQ_API_KEY y un SECRET_KEY
# reales. Si esa clave era tuya, ya está considerada comprometida: revócala en
# console.groq.com y genera un SECRET_KEY nuevo antes de desplegar.

# ── Obligatorio ────────────────────────────────────────────────────────
GROQ_API_KEY=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
SECRET_KEY=71cc2c10bd6e16301ca6109599c5bbbf094f7913166da3c37bad5c0c3cd53f03            

# ── Entorno ─────────────────────────────────────────────────────────────
# "production" deshabilita /docs, /redoc, /openapi.json y activa HSTS.
ENVIRONMENT=production

# ── Opcional (tienen defaults razonables en docker-compose.yml) ───────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_HISTORY_MESSAGES=20
SUMMARY_THRESHOLD=30
GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080

# ── Email de verificación (OTC-AUTH-01) — envío real por SMTP (MailerSend) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_8wsHD8h5_AGJTUiVgiGCr63NgGQuLhMiQ
SMTP_USE_TLS=true
# Mientras la cuenta de MailerSend esté en modo trial (dominio de test), solo
# se puede enviar correo a la casilla con la que te registraste en MailerSend.
# Verificá un dominio propio en MailerSend para enviar a cualquier destinatario.
EMAIL_FROM_ADDRESS=feedback-smtp.us-east-1.amazonses.com
EMAIL_FROM_NAME=FitMind

# ── Solo si usas el túnel de Cloudflare (perfil "cloudflare") ─────────
CLOUDFLARE_TUNNEL_TOKEN=
